{
  "name": "vue-nav-tab",
  "version": "2.5.2",
  "description": "Tab components for Vue.js project",
  "author": "Phạm Trung Kiên",
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs",
    "docs": "docsify serve docs",
    "lint": "eslint . --fix",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:package",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc -p tsconfig.build.json",
    "verify:consumer-browser": "node scripts/verify-consumer-browser.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "main": "dist/index.common.js",
  "module": "dist/index.es.js",
  "unpkg": "dist/vue-nav-tab.umd.js",
  "jsdelivr": "dist/vue-nav-tab.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./dist/index.common.js"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/vue-nav-tab.css",
    "./dist/vue-nav-tab.css": "./dist/vue-nav-tab.css",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/",
    "types/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "2.13.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.4.21",
    "docsify-cli": "4.4.3",
    "eslint": "9.39.5",
    "eslint-config-pk": "2.0.0",
    "eslint-plugin-vue": "10.11.0",
    "happy-dom": "20.14.5",
    "postcss": "8.5.28",
    "publint": "^0.3.24",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue": "3.5.43",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "keywords": [
    "vue",
    "tab"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/kien5436/vue-nav-tab.git",
    "type": "git"
  },
  "homepage": "https://kien5436.github.io/vue-nav-tab/",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "docsify"
    ]
  }
}
